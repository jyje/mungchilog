{
  "name": "mungchilog-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development NODE_OPTIONS=--experimental-sqlite tsx watch --env-file-if-exists=../../.env src/index.ts",
    "dev:oidc": "npm --prefix ../web run build && NODE_ENV=development WEB_PUBLIC_DIR=../web/dist NODE_OPTIONS=--experimental-sqlite tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "NODE_OPTIONS=--experimental-sqlite node dist/index.js",
    "test": "NODE_OPTIONS=--experimental-sqlite tsx --test src/*.test.ts src/route-providers/*.test.ts",
    "test:e2e": "NODE_OPTIONS=--experimental-sqlite tsx --env-file-if-exists=../../.env --test src/e2e/*.e2e.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "google-auth-library": "^11.0.2",
    "hono": "^4.6.14",
    "openid-client": "^6.8.7",
    "pg": "^8.23.0",
    "undici": "^8.10.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
