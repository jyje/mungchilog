VITE_GOOGLE_MAPS_API_KEY=AI...
GOOGLE_MAPS_SERVER_API_KEY=AI...

# Database backend. SQLite is the default when DB_PROVIDER is omitted and is
# convenient for local development. PostgreSQL is suited to managed or shared
# database deployments. Do not commit real database credentials.
DB_PROVIDER=sqlite
DB_SQLITE_PATH=./data/mungchilog.db
# DB_PROVIDER=postgres
# Use either a complete connection URL:
# DB_POSTGRES_URL=postgresql://username:password@hostname:5432/mungchilog?sslmode=require
# Or use fully namespaced connection settings:
# DB_POSTGRES_HOST=hostname
# DB_POSTGRES_PORT=5432
# DB_POSTGRES_DATABASE=mungchilog
# DB_POSTGRES_USERNAME=username
# DB_POSTGRES_PASSWORD=password

# M6 login (see docs/authentik-setup.md). Standard OIDC - any compliant
# provider works, not just Authentik. Leave all of these unset for local
# dev: the server then auto-logs-in as a local admin pseudo-user instead
# of requiring a real IdP (same graceful-degradation pattern as the Maps
# keys above).
OIDC_ISSUER_URL=https://authentik.app.jyje.online/application/o/mungchilog/
OIDC_CLIENT_ID=...
OIDC_CLIENT_SECRET=...
OIDC_REDIRECT_URI=https://mungchilog.app.jyje.online/auth/callback
# Optional for a real local OIDC test with Vite HMR. Authentik still calls
# localhost:3000, then the server returns the authenticated browser to Vite.
# LOCAL_WEB_ORIGIN=http://localhost:5173
# Store this only in an ignored local .env file or a deployment Secret. A
# comma-separated list seeds multiple pending administrator candidates.
INITIAL_ADMIN_EMAIL=admin@example.com,second-admin@example.com
