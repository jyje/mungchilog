VITE_GOOGLE_MAPS_API_KEY=AI...
GOOGLE_MAPS_SERVER_API_KEY=AI...

# M6 login (see docs/authentik-setup.md). Standard OIDC - any compliant
# provider works, not just Authentik. Leave all of these unset for local
# dev: the server then auto-logs-in as a local admin pseudo-user instead
# of requiring a real IdP (same graceful-degradation pattern as the Maps
# keys above).
OIDC_ISSUER_URL=https://authentik.app.jyje.online/application/o/mungchilog/
OIDC_CLIENT_ID=...
OIDC_CLIENT_SECRET=...
OIDC_REDIRECT_URI=https://mungchilog.app.jyje.online/auth/callback
# Whoever owns this email is auto-approved as admin on first login.
ADMIN_EMAIL=jyjeon@outlook.com
