# Copy this file to .env at the repository root. Every secret stays local:
# .env is ignored by Git and must never be committed.
#
# The application starts without either Maps key. Uncomment these only after
# creating the browser-restricted and server-restricted keys described in
# docs/google-maps-setup.md.
# VITE_GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_SERVER_API_KEY=

# Database backend. SQLite is the default when DB_PROVIDER is omitted and is
# convenient for local development. PostgreSQL is suited to managed or shared
# database deployments. Do not commit real database credentials.
DB_PROVIDER=sqlite
DB_SQLITE_PATH=./data/mungchilog.db
# DB_PROVIDER=postgres
# Use either a complete connection URL:
# DB_POSTGRES_URL=postgresql://username:password@hostname:5432/mungchilog?sslmode=require
# Or use fully namespaced connection settings:
# DB_POSTGRES_HOST=hostname
# DB_POSTGRES_PORT=5432
# DB_POSTGRES_DATABASE=mungchilog
# DB_POSTGRES_USERNAME=username
# DB_POSTGRES_PASSWORD=password

# Standard OIDC login (see docs/authentik-setup.md). Leave this entire block
# commented for the local admin pseudo-user. To exercise real Authentik login,
# register http://localhost:3000/auth/callback as a strict redirect URI, then
# uncomment every required OIDC setting and insert the local secret.
# OIDC_ISSUER_URL=https://authentik.app.jyje.online/application/o/mungchilog/
# OIDC_CLIENT_ID=mungchilog
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
#
# Vite HMR runs on 5173 while the OIDC callback remains on the API server at
# 3000. This explicit loopback origin is accepted only in development.
# LOCAL_WEB_ORIGIN=http://localhost:5173
#
# Optional local administrator bootstrap. A comma-separated list seeds
# multiple pending candidates. Use INITIAL_ADMIN_EMAIL for new configurations;
# ADMIN_EMAIL remains a legacy compatibility alias only.
# INITIAL_ADMIN_EMAIL=admin@example.com,second-admin@example.com

# Optional administrator usage dashboard integration. Application aggregates
# work without this block. Google metrics use Application Default Credentials,
# so do not put a service account key in this file or in Git.
# USAGE_MONITORING_GOOGLE_ENABLED=true
# GOOGLE_CLOUD_PROJECT_ID=your-google-cloud-project-id
# GOOGLE_MAPS_MONITORED_SERVICES=maps-backend.googleapis.com,places.googleapis.com,routes.googleapis.com,timezone-backend.googleapis.com
